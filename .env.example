# Required to connect the Discord bot. Copy the bot token from Developer Portal > Bot.
# Keep the real value only in .env. Never add it to this template or Git.
DISCORD_BOT_TOKEN=

# Optional: a development server ID for immediate command registration.
DISCORD_GUILD_ID=

# Required for AI-generated character dialogue in the Discord bot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: defaults to data/chubbie.sqlite3.
CHUBBIE_DATABASE_PATH=data/chubbie.sqlite3

# Optional accelerated evolution for local development. Conversational demo mode is started by an administrator
# with /chubbie demo start and always expires automatically.
CHUBBIE_DEMO_MODE=0
CHUBBIE_POLL_SECONDS=60

# Production ambient-participation defaults.
CHUBBIE_AMBIENT_MIN_MESSAGES=3
CHUBBIE_AMBIENT_WINDOW_SECONDS=600
CHUBBIE_AMBIENT_COOLDOWN_SECONDS=600
CHUBBIE_AMBIENT_MAX_PER_HOUR=3
CHUBBIE_AMBIENT_SAMPLE_PROBABILITY=0.30
CHUBBIE_DIRECT_COOLDOWN_SECONDS=3
CHUBBIE_MENTION_COOLDOWN_SECONDS=300

# Temporary /chubbie demo start defaults.
CHUBBIE_DEMO_MIN_MESSAGES=2
CHUBBIE_DEMO_WINDOW_SECONDS=90
CHUBBIE_DEMO_COOLDOWN_SECONDS=8
CHUBBIE_DEMO_MAX_MESSAGES=4
CHUBBIE_DEMO_SAMPLE_PROBABILITY=0.75
CHUBBIE_DEMO_CONTEXT_LIMIT=12


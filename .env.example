# Required to connect the Discord bot. Obtain this from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Optional: a development server ID for immediate command registration.
DISCORD_GUILD_ID=

# Optional: AI dialogue. The game uses entertaining deterministic fallback lines without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: defaults to data/chubbie.sqlite3.
CHUBBIE_DATABASE_PATH=data/chubbie.sqlite3

# Optional demo-only switches. Never enable silently in production.
CHUBBIE_DEMO_MODE=0
CHUBBIE_POLL_SECONDS=60

